    "expo": "~57.0.17",
    "expo-blur": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
